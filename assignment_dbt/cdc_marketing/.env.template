# Copy to .env, fill in, then:  set -a && source .env && set +a
# .env is git-ignored. Never commit real values.

# --- Workspace (all targets) ---------------------------------------------
# SQL Warehouses > <warehouse> > Connection details
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# --- dev target (your own user) -----------------------------------------
# Settings > Developer > Access tokens
DBT_TARGET=dev
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxx
DBT_DEV_SCHEMA=dbt_bart

# --- ci target (only needed to reproduce CI locally) --------------------
# DBT_CI_SCHEMA=pr_local

# --- production target (Service Principal, OAuth M2M) --------------------
# Normally only set in GitHub (environment "production"), not on laptops.
# DATABRICKS_CLIENT_ID=<service principal application id>
# DATABRICKS_CLIENT_SECRET=<service principal OAuth secret>
